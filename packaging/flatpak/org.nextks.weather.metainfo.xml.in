<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@KOS_APP_APP_ID@</id>
  <name>KOS Weather</name>
  <name xml:lang="zh_CN">KOS 天气</name>
  <summary>Current conditions and forecasts for saved places</summary>
  <summary xml:lang="zh_CN">查看常用地点的实时天气和预报</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="org.nextkde"><name>NextKde Contributors</name></developer>
  <description>
    <p>View current weather, hourly details and a seven-day forecast using Open-Meteo.</p>
    <p>Runs its own weather-only helper inside the sandbox. Network access is required for forecasts and place searches; no host filesystem permission is requested.</p>
  </description>
  <launchable type="desktop-id">@KOS_APP_APP_ID@.desktop</launchable>
  <provides><binary>kos-weather</binary></provides>
  <categories><category>Utility</category></categories>
  <url type="homepage">https://github.com/NextKde/kos-apps</url>
  <url type="bugtracker">https://github.com/NextKde/kos-apps/issues</url>
  <content_rating type="oars-1.1"/>
  <releases><release version="@PROJECT_VERSION@" date="@KOS_FLATPAK_RELEASE_DATE@"/></releases>
</component>
