{
  "app-id": "org.nextks.calculator",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "command": "kos-calculator",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--env=QML_IMPORT_PATH=/app/lib/qt6/qml:/app/lib/qml"
  ],
  "modules": [
    {
      "name": "kos-surface-shape",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "subdir": "shell/native/surface-shape",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ],
      "post-install": [
        "install -Dm644 /run/build/kos-surface-shape/LICENSE /app/share/licenses/kos-surface-shape/LICENSE"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/NextKde/NextKde.git",
          "commit": "d7b34a8e8b37a9fb7605333f10d02f7b16e70743",
          "disable-submodules": true
        }
      ]
    },
    {
      "name": "kos-calculator",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_TESTING=OFF",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DKOS_FLATPAK_BUILD=ON",
        "-DKOS_APPS=calculator"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            "tmp",
            "build",
            ".flatpak-builder"
          ]
        }
      ]
    }
  ]
}
